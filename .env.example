# ==========================================
# NyayaSetu Environment Configuration
# ==========================================

# Groq API Configuration
# Live Production Model IDs:
#   - llama-3.3-70b-versatile (Recommended for complex legal reasoning)
#   - llama-3.1-8b-instant (Ultra-low latency for direct lookups)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: live ChatGPT comparison panel (not used for NyayaSetu answers)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Retrieval & Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=5

# Server & Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database Paths
SQLITE_DB_PATH=data/processed/nyayasetu.db
VECTOR_STORE_DIR=data/processed/faiss_indices
